from django.shortcuts import render, get_object_or_404, redirect
from .models import Group, Student, Notification
from django.contrib.auth.decorators import login_required
from .forms import StudentForm, GroupForm

def home(request):
    groups = Group.objects.all()
    notifications = Notification.objects.order_by('-timestamp')[:5]
    query = request.GET.get('query')
    if query:
        groups = groups.filter(name__icontains=query)
    return render(request, 'main/home.html', {'groups': groups, 'notifications': notifications})

def group_detail(request, group_id):
    group = get_object_or_404(Group, id=group_id)
    students = group.students.all()
    return render(request, 'main/group_detail.html', {'group': group, 'students': students})

@login_required
def add_student(request, group_id):
    group = get_object_or_404(Group, id=group_id)
    if request.user != group.admin:
        return redirect('home')

    if request.method == 'POST':
        form = StudentForm(request.POST)
        if form.is_valid():
            student = form.save(commit=False)
            student.group = group
            student.save()
            return redirect('group_detail', group_id=group.id)
    else:
        form = StudentForm()
    return render(request, 'main/add_student.html', {'form': form, 'group': group})

@login_required
def create_group(request):
    if request.method == 'POST':
        form = GroupForm(request.POST, request.FILES)
        if form.is_valid():
            group = form.save(commit=False)
            group.admin = request.user
            group.save()
            return redirect('home')
    else:
        form = GroupForm()
    return render(request, 'main/create_group.html', {'form': form})
from django import forms
from .models import Student, Group

class StudentForm(forms.ModelForm):
    class Meta:
        model = Student
        fields = ['name', 'contact']

class GroupForm(forms.ModelForm):
    class Meta:
        model = Group
        fields = ['name', 'logo']
